# Copy this file to .env.local and fill in the values (used from Milestone 2).
# NEXT_PUBLIC_ variables are sent to the browser — only put SAFE values there.

# Supabase project URL — safe to expose
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable (anon) key — safe to expose, access is limited by RLS
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
